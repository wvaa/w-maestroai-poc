# ══════════════════════════════════════════════════════════════════════════════
# BrowserStack Credentials
# Obtener en: https://www.browserstack.com/accounts/settings
# ══════════════════════════════════════════════════════════════════════════════
BROWSERSTACK_USERNAME=YOUR_USERNAME
BROWSERSTACK_ACCESS_KEY=YOUR_ACCESS_KEY

# App subida a BrowserStack App Automate
# Subir APK/IPA via API:
#   curl -u "user:key" -X POST \
#     https://api-cloud.browserstack.com/app-automate/upload \
#     -F "file=@app.apk"
BROWSERSTACK_APP_ID=bs://<app-id>

# ── App bajo prueba ────────────────────────────────────────────────────────────
# Package ID de la app Android (appId usado en los flows de Maestro).
# Si se cambia el paquete, solo hay que modificar esta variable.
APP_PACKAGE=com.example.app

# ── Dispositivo Android en BrowserStack ────────────────────────────────────────
# Lista completa: https://www.browserstack.com/list-of-browsers-and-platforms/app_automate
BROWSERSTACK_DEVICE=Google Pixel 7
BROWSERSTACK_OS_VERSION=13.0

# Nombre del proyecto en BrowserStack (opcional)
BROWSERSTACK_PROJECT=Maestro_POC

# Túnel local BrowserStack (true/false)
BROWSERSTACK_LOCAL=false

# Idioma y locale del dispositivo (opcional)
# language: código ISO (ej: es, en, pt)
# locale: locale específico (ej: es_SV, es_MX, en_US)
BROWSERSTACK_LANGUAGE=es
BROWSERSTACK_LOCALE=es_SV

# ── Target de ejecución ────────────────────────────────────────────────────────
# 'cloud'  → BrowserStack App Automate API
# 'local'  → Emulador/dispositivo USB via Maestro CLI
RUN_TARGET=cloud

# ── Capabilities BrowserStack ──────────────────────────────────────────────────
BROWSERSTACK_BUILD_NAME=
BROWSERSTACK_NETWORK_LOGS=true
BROWSERSTACK_DEVICE_LOGS=true
BROWSERSTACK_DEBUG=true

# ── Maestro CLI (ejecución local) ──────────────────────────────────────────────
# Ruta al binario de Maestro. Usar ruta completa si no está en PATH.
# macOS/Linux: /Users/<user>/.maestro/bin/maestro
# Windows:     C:\Users\<user>\.maestro\bin\maestro.bat
MAESTRO_CLI_PATH=maestro

# Serial del dispositivo para ejecución local (dejar vacío para auto-detectar)
MAESTRO_DEVICE_SERIAL=

# ── Ejecución paralela local ───────────────────────────────────────────────────
# Lista de seriales separados por | para ejecutar en paralelo.
# Si se define, los tests se distribuyen entre los dispositivos listados.
# Si no se define, se usa MAESTRO_DEVICE_SERIAL (un solo dispositivo).
# Si ninguna está definida, se auto-detectan via ADB.
# Ejemplo: LOCAL_DEVICES=emulator-5554|R5CT20XXXXX|9A241XXXXX
#LOCAL_DEVICES=

# ── Asignación de tests por dispositivo (paralelo local) ──────────────────────
# N corresponde a la posición en LOCAL_DEVICES (1-indexed).
# LOCAL_DEVICE_{N}_NAME          = Nombre descriptivo para logs y reportes
# LOCAL_DEVICE_{N}_INCLUDE_TAGS  = Tags a incluir (separados por coma)
# LOCAL_DEVICE_{N}_EXCLUDE_TAGS  = Tags a excluir (separados por coma)
# LOCAL_DEVICE_{N}_EXECUTE       = Archivos YAML específicos (separados por coma)
#
# Ejemplo con 2 dispositivos:
#LOCAL_DEVICE_1_NAME=Pixel 7 - Thread 1
#LOCAL_DEVICE_1_INCLUDE_TAGS=smoke
#LOCAL_DEVICE_1_EXCLUDE_TAGS=regression
#
#LOCAL_DEVICE_2_NAME=Samsung A52 - Thread 2
#LOCAL_DEVICE_2_INCLUDE_TAGS=regression
#LOCAL_DEVICE_2_EXECUTE=flows/tests/smoke/APPSV002_login.yaml,flows/tests/smoke/APPSV003_home.yaml

# ── Filtrado por tags (ejecución simple) ───────────────────────────────────────
# Tags separados por coma. Si se define, solo se ejecutan los tests que tengan ese tag.
# Dejar vacío para ejecutar todos los tests.
BROWSERSTACK_TAGS=

# ── Ejecución paralela con Shards (BrowserStack Cloud) ────────────────────────
# Para habilitar shards, configura BROWSERSTACK_SHARDS_COUNT > 0.
# Si es 0 o no está definido, se ejecuta en modo simple (un dispositivo).
#
# Dispositivos para shards (separados por |). Cada shard toma un dispositivo.
# Si no se define, usa BROWSERSTACK_DEVICE-BROWSERSTACK_OS_VERSION.
# Ejemplo: BROWSERSTACK_DEVICES=Samsung Galaxy S25 Ultra-15.0|Google Pixel 7-13.0
BROWSERSTACK_DEVICES=

# Cantidad de shards (threads en paralelo). 0 = deshabilitado.
BROWSERSTACK_SHARDS_COUNT=0

# Selección de dispositivo por shard: 'any' o 'round-robin'
BROWSERSTACK_SHARDS_DEVICE_SELECTION=any

# Configuración por shard:
# BROWSERSTACK_SHARD_{N}_NAME         = Nombre del thread
# BROWSERSTACK_SHARD_{N}_INCLUDE_TAGS = Tags a incluir (separados por coma)
# BROWSERSTACK_SHARD_{N}_EXCLUDE_TAGS = Tags a excluir (separados por coma)
# BROWSERSTACK_SHARD_{N}_EXECUTE      = Archivos YAML específicos (separados por coma)
#                                        Rutas relativas desde la raíz del ZIP
#                                        Ej: flows/tests/smoke/APPSV002_login.yaml
#
# Ejemplo con 3 shards:
#BROWSERSTACK_SHARD_1_NAME=Thread 1
#BROWSERSTACK_SHARD_1_INCLUDE_TAGS=smoke
#BROWSERSTACK_SHARD_1_EXCLUDE_TAGS=wip
#
#BROWSERSTACK_SHARD_2_NAME=Thread 2
#BROWSERSTACK_SHARD_2_INCLUDE_TAGS=regression
#BROWSERSTACK_SHARD_2_EXCLUDE_TAGS=wip
#
#BROWSERSTACK_SHARD_3_NAME=Thread 3
#BROWSERSTACK_SHARD_3_INCLUDE_TAGS=e2e
#BROWSERSTACK_SHARD_3_EXCLUDE_TAGS=wip

# ── Reporte HTML ───────────────────────────────────────────────────────────────
# El reporte usa el diseño fijo del proyecto (Banca Digital El Salvador).
# Para el logo, colocar el archivo en: config/logo_cusca.png
